# Copy to .env and fill in ONE of these to enable full conversational reasoning.
# Without either, G.R.A.C.E. still handles time/date/status/face-ID locally.
# If both are set, Anthropic (Claude) takes priority over Groq.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: lets G.R.A.C.E. control Spotify playback by voice/text
# ("Grace, pon musica de X", "pausa la musica", "siguiente cancion").
# Create an app at https://developer.spotify.com/dashboard, add
# http://127.0.0.1:8000/api/spotify/callback as a Redirect URI there, then
# fill these in and do a one-time login at http://127.0.0.1:8000/api/spotify/login
# from a browser on the machine running the backend. Requires Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Strongly recommended if you expose this backend outside your home network
# (tunnel, port-forward): without it, anyone who finds the URL can enroll/
# delete faces, chat (burning your LLM credits), and control your Spotify.
# Pick any long random string and set the same value in the app's SERVIDOR
# settings as the "API key" field.
GRACE_API_KEY=
